classDiagram
    class Owner {
        +name: str
        +preferences: list[str]
        +pets: list[Pet]
        +add_pet(pet)
        +get_all_tasks()
    }
    class Pet {
        +name: str
        +species: str
        +tasks: list[Task]
        +add_task(task)
        +remove_task(task)
    }
    class Task {
        +title: str
        +duration_minutes: int
        +priority: str
        +due_date: date
        +preferred_time: time
        +frequency: str
        +completed: bool
        +mark_complete()
    }
    class Scheduler {
        +sort_by_time(tasks)
        +filter_tasks(owner, filters)
        +find_conflicts(tasks)
        +mark_task_complete(pet, task)
        +build_daily_plan(owner, date, start_time, available_minutes)
    }
    class DailyPlan {
        +plan_date: date
        +entries: list[ScheduleEntry]
        +skipped: list
        +conflicts: list[str]
    }
    Owner "1" --> "0..*" Pet : manages
    Pet "1" --> "0..*" Task : has
    Scheduler ..> Owner : reads tasks
    Scheduler ..> DailyPlan : creates
